# Public site URL — canonical tags, Open Graph, sitemap and robots derive from it.
NEXT_PUBLIC_SITE_URL=https://gnanachandra.com

# --- Contact form delivery -------------------------------------------------
# Preferred: Resend. Create a free key at https://resend.com/api-keys.
RESEND_API_KEY=
# Where submissions are sent.
CONTACT_TO_EMAIL=you@yourdomain.com
# Sender address. Resend's shared onboarding sender works until you verify a
# domain; after that use something like hello@yourdomain.com.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Alternative to Resend: any endpoint accepting a JSON POST (automation
# platform, CRM, Slack workflow). Ignored when RESEND_API_KEY is set.
CONTACT_WEBHOOK_URL=

# --- SEO --------------------------------------------------------------------
# Token from Google Search Console (HTML tag verification method). Adding it
# renders the verification meta tag so the property can be verified.
GOOGLE_SITE_VERIFICATION=
